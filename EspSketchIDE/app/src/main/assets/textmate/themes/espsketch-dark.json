{
  "name": "EspSketch Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#1E1F22",
    "editor.foreground": "#D4D6DB",
    "editorLineNumber.foreground": "#6F737A",
    "editorLineNumber.activeForeground": "#D4D6DB",
    "editor.lineHighlightBackground": "#26282E",
    "editor.selectionBackground": "#214283",
    "editorCursor.foreground": "#7FC8FF",
    "editorIndentGuide.background": "#393B40"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#7A7E85",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#2AACB8"
      }
    },
    {
      "scope": [
        "constant.language",
        "variable.language.this"
      ],
      "settings": {
        "foreground": "#CF8E6D"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.other",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.sizeof",
        "keyword.operator.cast"
      ],
      "settings": {
        "foreground": "#CF8E6D",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "storage.type.built-in"
      ],
      "settings": {
        "foreground": "#56A8F5"
      }
    },
    {
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor",
        "punctuation.definition.directive",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "scope": [
        "meta.preprocessor.include string",
        "string.quoted.other.lt-gt.include"
      ],
      "settings": {
        "foreground": "#6AAB73"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#57AAF7"
      }
    },
    {
      "scope": [
        "variable.other.macro",
        "entity.name.other.preprocessor.macro"
      ],
      "settings": {
        "foreground": "#B3AE60"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#F75464"
      }
    }
  ]
}